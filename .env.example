DATABASE_URL_UNPOOLED=postgresql+psycopg://user:password@localhost:5432/confianza
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=30
AGENT_API_KEY=replace-with-the-private-agent-api-key
AGENT_ACTIVATION_SECRET=replace-with-a-long-random-digest-secret
AGENT_ACTIVATION_EXPIRE_SECONDS=300
AGENT_JWT_SECRET=replace-with-a-separate-long-random-secret
